  fi
  if [[ ${args['--sort']:-} ]] && [[ ! ${args['--sort']:-} =~ ^(asc|desc)$ ]]; then
    printf "%s\n" "--sort must be one of: asc, desc" >&2
    exit 1
  fi

}

# :command.initialize
initialize() {
  declare -g version="0.7.1"
  set -euo pipefail

  # :command.environment_variables_default
  export KIKOERU_CLI_CACHE_DIR="${KIKOERU_CLI_CACHE_DIR:-/tmp/kikoeru_cli}"

}

# :command.run
run() {
  # :command.globals
  declare -g long_usage=''
  declare -g -A args=()
  declare -g -A deps=()
  declare -g -a env_var_names=()
  declare -g -a input=()

  normalize_input "$@"
  parse_requirements "${input[@]}"

  case "$action" in
    "favourite") kikoeru_cli_favourite_command ;;
  esac
}

# :command.start
start() {
  command_line_args=("$@")
  initialize
  run "${command_line_args[@]}"
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  start "$@"
fi
